{
  "version": 2,
  "buildCommand": "python3 manage.py collectstatic --noinput --clear && python3 manage.py migrate --noinput",
  "builds": [
    {
      "src": "jalbab/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "jalbab/wsgi.py"
    }
  ]
}